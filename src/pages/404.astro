---
import Layout from '../layouts/Layout.astro';
import Btn from '../components/Btn.astro';
---
<Layout title="Page not found | Limeflock">
  <section class="page-hero" style="min-height:80vh;display:grid;place-items:center">
    <div class="container">
      <h1 style="font-size:clamp(100px,18vw,220px)" class="text-lime">404</h1>
      <p style="font-size:20px;color:#fff;margin:10px 0 30px">This page took a wrong turn on Sheikh Zayed Road.</p>
      <Btn href="/">Back to home</Btn>
    </div>
  </section>
</Layout>
