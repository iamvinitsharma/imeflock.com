---
// Logos drawn in white/silver need a dark tile to stay visible.
const darkTile = new Set([4, 5, 6, 8, 11, 12, 13, 15]);
const logos = Array.from({ length: 16 }, (_, i) => i + 1).map((n) => {
  const ext = [1, 2].includes(n) ? 'jpeg' : [5, 14, 15].includes(n) ? 'webp' : n === 12 ? 'svg' : 'png';
  return { src: `/img/clients/client-${n}.${ext}`, dark: darkTile.has(n) };
});
---
<section class="brand-band">
  <div class="container">
    <a href="/portfolio/" class="trust">Trusted by growing brands worldwide</a>
    <div class="marquee">
      <div class="marquee-track">
        {[...logos, ...logos].map((l, i) => (
          <div class:list={['client-logo', { dark: l.dark }]} aria-hidden={i >= logos.length ? 'true' : undefined}>
            <img src={l.src} alt={i < logos.length ? 'Client logo' : ''} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
