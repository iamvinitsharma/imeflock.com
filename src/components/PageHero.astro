---
interface Props { title: string; crumbs: { label: string; href?: string }[]; sub?: string }
const { title, crumbs, sub } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <h1>{title}</h1>
    {sub && <p style="max-width:640px;margin:18px auto 0;color:#ddd;font-size:18px">{sub}</p>}
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      {crumbs.map((c) => (c.href ? <>/<a href={c.href}>{c.label}</a></> : <>/<span>{c.label}</span></>))}
    </nav>
    <slot />
  </div>
</section>
