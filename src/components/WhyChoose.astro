---
import Icon from './Icon.astro';
---
<section class="section" style="background:#000">
  <div class="container">
    <div class="sec-head">
      <div>
        <span class="label">(03) Why Choose Us?</span>
        <h2 class="h-lg reveal-text">One partner from screen to street</h2>
      </div>
      <p>Strategy, creative, tech and media buying in one team - fewer hand-offs, faster launches and one clear report.</p>
    </div>
    <div class="bento">
      <div class="tile">
        <video class="play-once" src="/video/c1-handshake-2.webm" muted playsinline preload="auto" style="object-fit:contain;top:-20%"></video>
        <div class="cap">
          <h4>Seamless Collaboration</h4>
          <p>Transparent communication and a dedicated manager at every stage of your project.</p>
        </div>
      </div>
      <div class="tile">
        <img class="parallax-img" src="/img/theme/c1-img-1.webp" alt="" loading="lazy" />
        <div class="glass"><Icon name="bolt" /><h4>Fast<br />Turnaround</h4></div>
      </div>
      <div class="tile">
        <img class="parallax-img" src="/img/theme/c1-img-2.webp" alt="" loading="lazy" />
        <div class="cap">
          <h4>Proven Results</h4>
          <p>Hundreds of campaigns launched across web, social, search and outdoor media.</p>
        </div>
      </div>
      <div class="tile wide">
        <div>
          <div class="stars">★★★★★</div>
          <h4 style="font-size:24px;margin-top:8px">150+ Happy clients</h4>
        </div>
        <span style="width:1px;height:70px;background:var(--line)"></span>
        <div class="avatars">
          <img src="/img/theme/t1-author-9.webp" alt="" loading="lazy" />
          <img src="/img/theme/t1-author-10.webp" alt="" loading="lazy" />
          <img src="/img/theme/t1-author-11.webp" alt="" loading="lazy" />
          <img src="/img/theme/t1-author-1.webp" alt="" loading="lazy" />
        </div>
      </div>
      <div class="tile short">
        <div>
          <p style="color:#fff;font-weight:600;font-family:var(--font-head);margin-bottom:8px"><span class="text-lime">◷</span> 7 day launch</p>
          <video src="/video/c1-clock.webm" autoplay muted loop playsinline style="position:static;width:110px;height:110px;margin:auto"></video>
        </div>
      </div>
    </div>
  </div>
</section>
