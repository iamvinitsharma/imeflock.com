---
import Icon from './Icon.astro';
import { site } from '../data/site';
import BirdShowcase from './BirdShowcase.astro';
---
<section class="section" style="background:#000">
  <div class="container connect">
    <div class="connect-img"><BirdShowcase /></div>
    <div>
      <span class="label">(09) Contact Us</span>
      <h2 class="h-lg reveal-text">Want to work with us? Let's connect</h2>
      <div class="socials">
        <a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp <i><Icon name="whatsapp" /></i></a>
        {site.social.map((s) => <a class="magnetic" href={s.href} target="_blank" rel="noopener">{s.name} <i><Icon name={s.icon} /></i></a>)}
        <a href="/contact/">Get In Touch <i><Icon name="arrow" /></i></a>
      </div>
      <div class="info-cards">
        <div>
          <span class="ico"><Icon name="pin" /></span>
          <h5>Office Address</h5>
          <p>{site.address.map((l) => <>{l}<br /></>)}{site.poBox}</p>
        </div>
        <div>
          <span class="ico"><Icon name="phone" /></span>
          <h5>Call & WhatsApp</h5>
          <p><b>Call</b> <a href={site.phoneHref}>{site.phone}</a><br /><b>Mail</b> <a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div>
          <span class="ico"><Icon name="clock" /></span>
          <h5>Business Hours</h5>
          <p>{site.hours.map((h) => <>{h}<br /></>)}</p>
        </div>
      </div>
    </div>
  </div>
</section>
