---
import Btn from './Btn.astro';
import { works, type Work } from '../data/portfolio';
interface Props { items?: Work[]; head?: boolean; fly?: boolean; more?: boolean }
const pick = (cat: Work['cat'], n = 0) => works.filter((w) => w.cat === cat)[n];
// default: a mix of outdoor, websites and events
const { items = [pick('ooh'), pick('web'), pick('events'), pick('web', 1)], head = true, fly = false, more = true } = Astro.props;
---
<section class="section">
  <div class="container">
    {head && (
      <div class="sec-head">
        <div>
          <span class="label">(05) Our Work</span>
          <h2 class="h-lg reveal-text">Campaigns, events & websites we're proud of</h2>
        </div>
        <p>From billboards and LED trucks to live acts and high-converting websites - for brands in the UAE and worldwide.</p>
      </div>
    )}
    <div class:list={['portfolio-grid', { fly }]}>
      {items.map((w) => (
        <div class:list={['work-item', { rv: !fly }]}>
          <div class="work">
            <img src={w.img} alt={w.title} loading="lazy" />
            <div class="tags">{w.tags.map((t) => <span class="tag">{t}</span>)}</div>
            <a href={w.href ?? '/portfolio/'} class="view" aria-label={`View ${w.title}`}>View</a>
          </div>
          <h4 style="font-size:20px;margin-top:16px">{w.title}</h4>
        </div>
      ))}
    </div>
    {more && <div class="center" style="margin-top:50px"><Btn href="/portfolio/" variant="dark">View full portfolio</Btn></div>}
  </div>
</section>
