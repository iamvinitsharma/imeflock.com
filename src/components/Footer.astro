---
import Icon from './Icon.astro';
import Btn from './Btn.astro';
import Bird from './Bird.astro';
import { site } from '../data/site';
import { categories, services } from '../data/services';
const year = new Date().getFullYear();
const stats = [
  ['300+', 'Projects', 'Delivered'], ['98%', 'Client', 'Retention'], ['40+', 'Services', 'Under one roof'], ['24/7', 'Campaign', 'Monitoring'], ['10+', 'Years of', 'Experience'],
];
const popular = services.filter((s) => s.hot).slice(0, 7);
---
<div class="stats-strip">
  <div class="marquee-track">
    {[...stats, ...stats, ...stats, ...stats].map(([n, a, b]) => (
      <div class="st"><b>{n}</b><span>{a}<br />{b}</span></div>
    ))}
  </div>
</div>
<footer class="footer">
  <div class="container">
    <div class="f-cta">
      <div class="f-perch" title="Hi! 👋"><Bird uid="perch" class="perch-bird" /></div>
      <div>
        <span class="label">Let's grow together</span>
        <h2>Ready to take <span class="text-lime">flight?</span></h2>
        <p>Tell us where you want your brand to go. We'll reply within the hour with a clear plan and a fixed quote.</p>
      </div>
      <div class="f-cta-actions">
        <Btn href="/contact/">Get a free proposal</Btn>
        <a href={site.whatsapp} class="f-wa" target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp {site.phone}</a>
      </div>
    </div>

    <div class="footer-grid">
      <div class="about-f">
        <img src="/img/logo-light.webp" alt="Limeflock" width="190" height="66" loading="lazy" />
        <p>Dubai's digital growth partner - websites, performance marketing, AI and outdoor advertising under one roof.</p>
        <div class="f-social">
          {site.social.map((s) => <a class="magnetic" href={s.href} aria-label={s.name} target="_blank" rel="noopener"><Icon name={s.icon} /></a>)}
        </div>
      </div>
      <div>
        <h5>Popular Services</h5>
        <ul>{popular.map((s) => <li><a href={`/${s.slug}/`}>{s.title}</a></li>)}</ul>
      </div>
      <div>
        <h5>What We Do</h5>
        <ul>{categories.map((c) => <li><a href={`/services/#${c.slug}`}>{c.title}</a></li>)}</ul>
      </div>
      <div>
        <h5>Get in Touch</h5>
        <ul class="f-contact">
          <li><Icon name="phone" /><a href={site.phoneHref}>{site.phone}</a></li>
          <li><Icon name="mail" /><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><Icon name="pin" /><span>{site.address.join(', ')}<br />{site.poBox}</span></li>
          <li><Icon name="clock" /><span>{site.hours.join(' · ')}</span></li>
        </ul>
        <div class="avail">Available for new projects</div>
      </div>
    </div>
  </div>

  <div class="f-wordmark" aria-hidden="true">
    <span>LIMEFLOCK</span>
    <div class="f-fly"><Bird uid="ffly" simple class="flap" /></div>
  </div>

  <div class="container">
    <div class="copy">
      <span>© {year} Limeflock. All rights reserved.</span>
      <nav><a href="/about/">About</a><a href="/services/">Services</a><a href="/portfolio/">Portfolio</a><a href="/contact/">Contact</a></nav>
      <span>Digital Growth Partner · Dubai, UAE</span>
    </div>
  </div>
</footer>
<a class="wa-float" href={site.whatsapp} target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><Icon name="whatsapp" /></a>
<button class="to-top" id="to-top" aria-label="Back to top"><Icon name="arrow" /></button>
